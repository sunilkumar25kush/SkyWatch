# SkyWatch Environment Configuration
# OpenWeather API Key (Free tier or OneCall tier from https://openweathermap.org/api)
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# App Environment (development | production)
EXPO_PUBLIC_APP_ENV=development

# Default Initial City Name & Coordinates (Fallback when GPS permission is denied)
EXPO_PUBLIC_DEFAULT_CITY=New Delhi
EXPO_PUBLIC_DEFAULT_LAT=28.6139
EXPO_PUBLIC_DEFAULT_LON=77.2090
